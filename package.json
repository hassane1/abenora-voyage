{
  "name": "abenora-voyage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3016 -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "tsx prisma/seed.ts --reset",
    "db:upgrade": "tsx prisma/upgrade.ts",
    "db:programmes": "tsx prisma/load-programmes.ts",
    "db:composer": "tsx prisma/load-composer.ts",
    "db:studio": "prisma studio",
    "test:booking": "node scripts/test-booking-flow.mjs",
    "test:agence": "node scripts/test-agence.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:security": "node scripts/test-security.mjs",
    "db:purge": "tsx prisma/purge.ts",
    "test:unit": "vitest run",
    "import:voyages": "tsx scripts/import-voyages.ts",
    "make:modele-voyages": "node scripts/make-modele-voyages.mjs",
    "check:photos": "node scripts/check-destination-photos.mjs",
    "import:historique": "tsx scripts/import-historique.ts",
    "make:historique": "node scripts/make-historique.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "next": "16.4.6",
    "nodemailer": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autocannon": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
