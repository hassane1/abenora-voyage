# Base de données (SQLite en local ; PostgreSQL en production)
DATABASE_URL="file:./dev.db"

# Session administrateur (chaîne aléatoire longue)
AUTH_SECRET="remplacer-par-une-longue-chaine-aleatoire"

# Compte administrateur créé par le seed (à changer en production)
ADMIN_EMAIL="admin@rimal.local"
ADMIN_PASSWORD="choisir-un-mot-de-passe-solide"

# URL publique du site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Rimal"

# WhatsApp de l'agence, format international sans + ni espaces (ex. 2126XXXXXXXX). Vide = bouton vers la page contact
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# E-mails (SMTP). Vide = les e-mails sont journalisés dans l'admin (Notifications) sans être envoyés
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Rimal <reservations@example.com>"
ADMIN_NOTIFY_EMAIL="admin@rimal.local"

# Chatbot (Claude, Anthropic). Vide = assistant en mode simplifié (réponses FAQ/catalogue sans IA)
# Clé à créer sur https://console.anthropic.com — ne jamais la publier
ANTHROPIC_API_KEY=""

# Routage cartographique (OSRM). Serveur de démonstration public par défaut — à remplacer en production
NEXT_PUBLIC_OSRM_URL="https://router.project-osrm.org"
