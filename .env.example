# Base de données (SQLite en local ; PostgreSQL en production)
DATABASE_URL="file:./dev.db"

# Session administrateur (chaîne aléatoire longue)
AUTH_SECRET="remplacer-par-une-longue-chaine-aleatoire"

# Compte administrateur créé par le seed. Le mot de passe n’est jamais écrit ici : passez ADMIN_PASSWORD (20 caractères minimum)
# uniquement le temps de la commande, ex. PowerShell : $env:ADMIN_PASSWORD="…"; npm run db:seed; Remove-Item Env:ADMIN_PASSWORD
ADMIN_EMAIL="admin@benani-travel.local"

# URL publique du site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Benani Travel"

# WhatsApp de l'agence, format international sans + ni espaces (ex. 2126XXXXXXXX). Vide = bouton vers la page contact
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# E-mails (SMTP). Vide = les e-mails sont journalisés dans l'admin (Notifications) sans être envoyés
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Benani Travel <reservations@example.com>"
ADMIN_NOTIFY_EMAIL="admin@benani-travel.local"

# Assistant IA (Anthropic). Clé à créer sur https://console.anthropic.com — ne jamais la publier. Vide = assistant en mode simplifié (FAQ / catalogue sans IA)
ANTHROPIC_API_KEY=""

# Routage cartographique (OSRM). Serveur de démonstration public par défaut — à remplacer en production
NEXT_PUBLIC_OSRM_URL="https://router.project-osrm.org"

# --- Sécurité ---------------------------------------------------------------
# MFA (TOTP) obligatoire pour toute l'équipe d'administration. "false" UNIQUEMENT en développement.
ADMIN_MFA_REQUIRED="true"
# Site servi via Cloudflare ou le tunnel (serveur à l'écoute sur 127.0.0.1) : 1 = lire l'IP réelle dans CF-Connecting-IP. Sinon l'IP vaut « unknown ».
TRUST_PROXY="1"
# Multiplicateur des limites de débit (tests de charge uniquement, ex. 1000). Ne pas définir en production.
# RATE_LIMIT_MULTIPLIER="1"
# Cache mémoire des pages publiques (60 s, vidé à chaque modification admin). "off" pour le désactiver.
# CATALOG_CACHE="on"
# Identifiant du modèle de l'assistant IA. Vide = assistant en mode simplifié
ASSISTANT_MODEL=""
